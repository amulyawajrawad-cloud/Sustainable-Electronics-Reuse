# Copy to .env and edit. Never commit the real .env.

# REQUIRED in real use: long random string used to sign session cookies.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional (defaults shown)
PORT=5000
DATABASE_PATH=data/recircuit.db
UPLOAD_DIR=uploads
FRONTEND_DIR=../frontend
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Used by `python manage.py seed` to create the first admin
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@recircuit.local
ADMIN_PASSWORD=ChangeMe-Admin-123
